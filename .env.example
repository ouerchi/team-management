# Public example credentials for local Docker use only, not production secrets.
# Docker Compose uses these defaults even without an .env file.
POSTGRES_USER=team
POSTGRES_PASSWORD=local_demo_password
POSTGRES_DB=team_management

# For running Prisma or Next.js on the host. Docker uses db:5432 instead.
DATABASE_URL="postgresql://team:local_demo_password@localhost:5433/team_management"
